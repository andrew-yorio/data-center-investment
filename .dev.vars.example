# Copy to .dev.vars for `npm run pages:dev`. Never commit .dev.vars.
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=
# Turnstile test secret that always passes. Replace in production.
TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA
EMAIL_API_KEY=
EMAIL_FROM=Placeholder <hello@example.com>
# Optional. When EMAIL_API_KEY is empty and this is "1", confirmation links are logged instead of emailed.
DEV_LOG_EMAILS=1
